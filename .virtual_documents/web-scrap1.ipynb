import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from  sklearn.preprocessing  import  StandardScaler

df=pd.read_csv('abc.csv')













x_train,x_test,y_train,y_test=train_test_split(df.drop('Purchased',axis=1),df['Purchased'],random_state=0,test_size=0.3)
Scaler=StandardScaler()
Scaler.fit(x_train)

x_train_scaled=Scaler.transform(x_train)
x_test_scaled=Scaler.transform(x_test)




x_train_scaled=pd.DataFrame(x_train_scaled,columns=x_train.columns)
x_test_scaled=pd.DataFrame(x_test_scaled,columns=x_test.columns)
x_train_scaled


fig, (ax1, ax2) = plt.subplots(ncols=2, figsize=(12, 5))

ax1.scatter(x_train['Age'], x_train['EstimatedSalary'])
ax1.set_title("Before Scaling")
ax2.scatter(x_train_scaled['Age'], x_train_scaled['EstimatedSalary'],color='red')
ax2.set_title("After Scaling")
plt.show()



from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score

lg=LogisticRegression()
lg_scaled=LogisticRegression()


lg.fit(x_train,y_train)
lg_scaled.fit(x_train_scaled,y_train)





x_predict=lg.predict(x_test)
x_predict_scaled=lg_scaled.predict(x_test_scaled)

print("Actual data  : ",accuracy_score(y_test,x_predict))
print("Scaled data  : ",accuracy_score(y_test,x_predict_scaled))




from sklearn.tree import DecisionTreeClassifier
dt = DecisionTreeClassifier()
dt_scaled = DecisionTreeClassifier()
dt.fit(x_train,y_train)
dt_scaled.fit(x_train_scaled,y_train)
DecisionTreeClassifier()
y_pred = dt.predict(x_test)
y_pred_scaled = dt_scaled.predict(x_test_scaled)
print("Actual",accuracy_score(y_test,y_pred))
print("Scaled",accuracy_score(y_test,y_pred_scaled))









